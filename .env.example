APP_ENV=local
TIMEZONE=Asia/Seoul
DRY_RUN=true
LOG_LEVEL=INFO

# BigQuery settings
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
BQ_PROJECT_ID=okpos-sales-load
BQ_DATASET=marts
BQ_TABLE=fact_total_sales
BQ_ROW_KEY_COLUMN=row_key
BQ_DATE_COLUMN=sales_date
BQ_GROSS_SALES_COLUMN=gross_sales
BQ_NET_SALES_COLUMN=net_sales
BQ_ORDER_ID_COLUMN=
BQ_CATEGORY_COLUMN=category_mid
BQ_PRODUCT_COLUMN=product_name
BQ_STORE_COLUMN=store_name
BQ_QUANTITY_COLUMN=quantity
BQ_DISCOUNT_AMOUNT_COLUMN=discount_amount
BQ_SUPPLY_AMOUNT_COLUMN=supply_amount
BQ_VAT_AMOUNT_COLUMN=vat_amount
BQ_POS_TYPE_COLUMN=pos_type
# Optional. Leave empty when the mart only has a DATE column and no sale timestamp/hour.
BQ_SALE_HOUR_COLUMN=

# Reporting options
REPORT_TOP_N_PRODUCTS=10
OUTPUT_DIR=output
LOG_DIR=logs

# OpenAI settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45

# Email settings
EMAIL_FROM=no-reply@example.com
EMAIL_SUBJECT_PREFIX=[탭샵바]
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
EMAIL_TO=analyst1@example.com,analyst2@example.com
# Alternative recipient sources. If set, these override EMAIL_TO.
RECIPIENTS_FILE=config/recipients.csv
RECIPIENTS_JSON=
# Optional dry-run recipients. If empty, no mail is sent during dry run.
DRY_RUN_RECIPIENTS=tester@example.com
