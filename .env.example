APP_ENV=local
TIMEZONE=Asia/Seoul
DRY_RUN=true
LOG_LEVEL=INFO

# BigQuery settings
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET=your_dataset
BQ_TABLE=your_pos_table
BQ_DATE_COLUMN=sale_timestamp
BQ_GROSS_SALES_COLUMN=gross_sales
BQ_NET_SALES_COLUMN=net_sales
BQ_ORDER_ID_COLUMN=order_id
BQ_CATEGORY_COLUMN=category_name
BQ_PRODUCT_COLUMN=product_name
BQ_STORE_COLUMN=store_name
# Optional. Keep empty if your datamart has no quantity field.
BQ_QUANTITY_COLUMN=quantity

# Reporting options
REPORT_TOP_N_PRODUCTS=10
OUTPUT_DIR=output
LOG_DIR=logs

# OpenAI settings
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=45

# Email settings
EMAIL_FROM=no-reply@example.com
EMAIL_SUBJECT_PREFIX=[탭샵바]
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
EMAIL_TO=analyst1@example.com,analyst2@example.com
# Alternative recipient sources. If set, these override EMAIL_TO.
RECIPIENTS_FILE=config/recipients.csv
RECIPIENTS_JSON=
# Optional dry-run recipients. If empty, no mail is sent during dry run.
DRY_RUN_RECIPIENTS=tester@example.com
